# Terraform working directories
**/.terraform/*

# Terraform state can contain sensitive data
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Saved Terraform plans
*.tfplan
plan.out

# Variable files may contain secrets
*.tfvars
*.tfvars.json

# Terraform crash and override files
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Environment files and credentials
.env
.env.*
!.env.example
.aws/
credentials
*.pem
*.key
*.p12

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Generated build files
build/
dist/
*.zip

# Editors and macOS
.DS_Store
.vscode/
.idea/
